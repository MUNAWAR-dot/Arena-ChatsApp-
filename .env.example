# ── Chatsapp frontend environment ───────────────────────────
# Copy to .env.local and fill in real values (Netlify env vars for production).

# Socket.IO server URL (your Render server URL).
# Leave empty for same-origin deployment (same host serves the app + socket).
VITE_SOCKET_URL=https://chatsapp-server.onrender.com

# REST API base URL (used for OTP auth, Google OAuth, push subscription)
VITE_API_URL=https://chatsapp-server.onrender.com

# Google OAuth client ID (must match the server's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Web Push public key (must match server's VAPID_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=

# Cloudinary media storage (free tier)
# 1. Create a Cloudinary account → Dashboard shows Cloud name
# 2. Settings → Upload → Add unsigned upload preset
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Optional translation endpoint
VITE_TRANSLATE_URL=
