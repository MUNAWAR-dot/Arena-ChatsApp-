# ── Chatsapp server environment (local development defaults) ──
# Replace with production values before deploying.

# PostgreSQL connection string (Prisma)
DATABASE_URL=postgresql://chatsapp:chatsapp@localhost:5432/chatsapp?schema=public

# Server port
PORT=3001

# CORS origin for the web client (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# OTP delivery — set to "1" ONLY for local development without an SMS gateway.
# In production leave unset; wire your gateway in src/index.ts.
SMS_SIMULATION_DELIVERY=1

# Reserved for future JWT-based auth
SESSION_SECRET=dev-only-change-me
