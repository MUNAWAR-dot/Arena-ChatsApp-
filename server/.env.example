# ── Chatsapp server environment ─────────────────────────────
# Copy to .env and fill in real values.

# PostgreSQL connection string (Neon free tier, Render, etc.)
DATABASE_URL=postgresql://chatsapp:chatsapp@localhost:5432/chatsapp?schema=public

# Server port (Render sets its own PORT env — this is the fallback)
PORT=3001

# Comma-separated origins allowed by CORS (your Netlify URL)
CORS_ORIGIN=https://chatsapp.netlify.app,http://localhost:5173

# OTP delivery — set to "1" ONLY for local development without an SMS gateway.
# In production leave "0" and wire your gateway in src/index.ts.
SMS_SIMULATION_DELIVERY=0

# Google OAuth (optional). Create an OAuth client ID at Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Web Push (optional, free). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chatsapp.example

# Reserved
SESSION_SECRET=change-me-to-a-long-random-string
